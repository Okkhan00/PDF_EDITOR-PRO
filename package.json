{
  "name": "pdfedit-pro-android",
  "version": "1.3.0",
  "private": true,
  "description": "PdfEdit Pro V1.3 wrapped as an Android app with Capacitor",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "build": "node scripts/vendor.js",
    "sync": "npm run build && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/lato": "^5.0.0",
    "@fontsource/montserrat": "^5.0.0",
    "@fontsource/open-sans": "^5.0.0",
    "@fontsource/poppins": "^5.0.0",
    "@fontsource/roboto": "^5.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "5.0.4",
    "tesseract.js-core": "^5.0.0",
    "typescript": "^5.5.0"
  },
  "engines": { "node": ">=20" }
}
